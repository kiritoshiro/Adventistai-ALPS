# Normalise line endings so a Windows checkout and a Linux CI checkout hold
# byte-identical files.
#
# The asset build names its output by content hash, so a single CRLF in a
# source file changes the file names in public/ and fails the committed-asset
# check in ci.yml (the old bud build did this with logo.svg in 940c749 and
# fc0a709).
* text=auto eol=lf

# Binary files must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.zip   binary
*.mo    binary
