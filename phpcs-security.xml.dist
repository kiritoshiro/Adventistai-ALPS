<?xml version="1.0"?>
<ruleset name="Adventistai ALPS WordPress Security">
    <description>Security-focused WordPress Coding Standards checks for maintained theme code.</description>

    <file>app</file>
    <file>functions.php</file>
    <file>index.php</file>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/resources/views/*</exclude-pattern>
    <!-- Bundled upstream TGM Plugin Activation library; do not fork vendor code for local style/security rewrites. -->
    <exclude-pattern>*/app/plugin-activation.php</exclude-pattern>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.RestrictedFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
</ruleset>
